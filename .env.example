# Copy to .env and change in anything but local dev.

# --- Postgres (API, worker, Alembic all use this one URL) -------------------
DATABASE_URL=postgresql+psycopg://ntf:ntf@postgres:5432/notifications

# --- Redis (Celery broker, rate limiter, response cache) --------------------
REDIS_URL=redis://redis:6379/0

# --- ClickHouse (delivery event store, analytics only) ---------------------
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DATABASE=notifications
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=devpassword
CLICKHOUSE_ENABLED=true

# --- Delivery policy -------------------------------------------------------
MAX_ATTEMPTS_DEFAULT=5
RETRY_BASE_SECONDS=2
RETRY_CAP_SECONDS=300
WEBHOOK_TIMEOUT_SECONDS=5
# A delivery left in "delivering" longer than this is assumed crashed and
# re-queued by the reclaimer task.
STUCK_DELIVERY_TIMEOUT_SECONDS=300
RECLAIMER_INTERVAL_SECONDS=60
# Messages each worker thread keeps in flight. 1 looks safer and is ~90x
# slower on this stack; see the benchmark in the README.
WORKER_PREFETCH_MULTIPLIER=8
# A queued notification this far past due is assumed lost and re-published.
QUEUED_SWEEP_GRACE_SECONDS=120
SWEEPER_INTERVAL_SECONDS=60

# --- Rate limiting (per tenant, token bucket in Redis) ---------------------
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=60

# --- Caching ---------------------------------------------------------------
NOTIFICATION_CACHE_TTL_SECONDS=5
TENANT_CACHE_TTL_SECONDS=60

# --- Email channel ---------------------------------------------------------
# Leave SMTP_HOST empty to use the console transport (message is logged
# instead of sent) - that is what local dev and CI use.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@example.com
SMTP_STARTTLS=true

# --- Observability ---------------------------------------------------------
METRICS_PORT=9101
LOG_LEVEL=INFO
# Keep at 1 unless you enable prometheus multiprocess mode - see README.
UVICORN_WORKERS=1
